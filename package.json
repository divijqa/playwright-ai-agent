{
  "name": "playwright-ai-agent",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run playwright:test",
    "test:schema": "npx playwright test tests/ai-schema.spec.ts",
    "test:comparison": "npx playwright test tests/ai-vs-static.spec.ts",
    "test:data": "./scripts/run-tests.sh data",
    "playwright:test": "npx playwright test",
    "test:artifacts": "DEMO_FAILURE_ARTIFACTS=true npx playwright test tests/failure-artifacts.spec.ts",
    "serve-test": "sh -c \"npx http-server test-pages -p ${TEST_SERVER_PORT:-8081}\"",
    "typecheck": "tsc --noEmit",
    "start:agent": "npx tsx agent.ts",
    "test:local": "./scripts/run-tests.sh local",
    "test:baseline": "./scripts/run-tests.sh baseline",
    "test:server": "./scripts/run-tests.sh server",
    "test:all": "./scripts/run-tests.sh all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@lancedb/lancedb": "^0.38.0",
    "@langchain/core": "^1.2.5",
    "@langchain/ollama": "^1.3.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "dotenv": "^18.0.5",
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6",
    "playwright-stealth": "^0.0.1",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
}
